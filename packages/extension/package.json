{
  "name": "builtin.git",
  "version": "0.0.0-dev",
  "description": "Editor extension entry point for the built-in Git integration.",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "dist/gitMain.js",
  "scripts": {
    "#test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "#test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch",
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand test/UiSourceControlProviderGit.test.ts"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/api": "^8.75.0",
    "execa": "^9.6.1",
    "jest-environment-lvce-editor": "^0.70.8"
  }
}
